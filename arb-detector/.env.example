# Copy to .env and fill in real credentials.

# --- General ---
ARB_POLL_INTERVAL_SECONDS=30
ARB_MIN_PROFIT_MARGIN=0.005          # 0.5% minimum edge before an opportunity is reported
ARB_BETFAIR_COMMISSION=0.05          # Betfair market base commission rate

# Comma-separated list of sources to enable: mock, betfair, oddsapi
ARB_ENABLED_SOURCES=mock

# --- Betfair Exchange API ---
# https://developer.betfair.com/ - requires an app key and either
# interactive (username/password) or certificate login.
ARB_BETFAIR_APP_KEY=
ARB_BETFAIR_USERNAME=
ARB_BETFAIR_PASSWORD=
# Optional client certificate pair for non-interactive (bot) login:
ARB_BETFAIR_CERT_FILE=
ARB_BETFAIR_KEY_FILE=
# Event type ids to scan (1=Soccer, 2=Tennis, 7522=Basketball, ...)
ARB_BETFAIR_EVENT_TYPE_IDS=1,2

# --- The Odds API (aggregates odds from many bookmakers) ---
# https://the-odds-api.com/
ARB_ODDS_API_KEY=
ARB_ODDS_API_SPORTS=soccer_epl,tennis_atp_french_open
ARB_ODDS_API_REGIONS=au,uk,eu
